# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Qubic RPC
RPC_BASE_URL=https://rpc.qubic.org/
POLL_INTERVAL_MS=2000

# Detection rule
WHALE_THRESHOLD_QU=5000

# EasyConnect webhook (replace with actual webhook)
EASYCONNECT_WEBHOOK_URL=https://hooks.example.com/your-webhook

# Keep recent alerts (size)
RECENT_ALERTS_LIMIT=200
